one_sample_test <- function(values, group_label) {
  shapiro_p <- tryCatch(shapiro.test(values)$p.value, error = function(e) NA)
  if (!is.na(shapiro_p) && shapiro_p > 0.05) {
    res <- t.test(values, mu = 0); method <- "one-sample t-test"
  } else {
    res <- wilcox.test(values, mu = 0); method <- "one-sample Wilcoxon signed-rank test"
  }
  p <- res$p.value
  p_lab <- if (p < 0.0001) "P < 0.0001" else paste0("P = ", signif(p, 3))
  cat(sprintf("\n--- %s vs 0: %s, n = %d, median = %.2f, %s ---\n", group_label, method, length(values), median(values), p_lab))
  print(res)
  list(p = p, p_lab = p_lab, method = method)
}

