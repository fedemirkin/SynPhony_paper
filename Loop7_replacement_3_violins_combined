# 1. Clade colours (match Fig 1A / S6 Fig)
# ------------------------------------------------------------
clade_colours <- c(
  "Clade_1"  = "#ff8080",
  "Clade_2"  = "#ff9955",
  "Clade_3"  = "#ffcc00",
  "Clade_4"  = "#ff2a7f",
  "Clade_5"  = "#e9afdd",
  "Clade_6"  = "#8080ff",
  "Clade_7"  = "#00aad4",
  "Clade_8"  = "#2ca089",
  "Clade_9"  = "#7f2a7f",
  "Clade_10" = "#aad400"
)

