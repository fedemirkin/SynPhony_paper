############################################################
# Loop 7 swap tolerance: combined figure (Panels A, C, B)
#
# Panel A: overall split violin, chimera vs WT pLDDT, pooled
#          across all donor clades, coloured by clade
# Panel C: the same comparison broken out per individual donor
#          clade (not pooled), ordered Clade_1 -> Clade_10
# Panel B: Delta (pLDDT - pLDDT_replacement), R-type (Clades
#          1-7) vs Y-type (Clade_10) donor loops
#
# Throughout: circle = chimera (SAP05 + donor Loop 7),
#             triangle = WT (donor's own native domain).
# WP_011412316.1 (canonical SAP05) is drawn in black, on top
# of every other point, in all three panels.
#
# No extra packages beyond ggplot2 + dplyr + patchwork are
# required (split violins are built manually from density()
# output, since gghalves/see are not available through apt in
# this environment).
############################################################

library(ggplot2)
library(dplyr)
library(patchwork)

