cat(sprintf(
  "\nSummary: Kruskal-Wallis across Clades 1-7 (chimera pLDDT), %s -> %s\n",
  kw_p_label,
  ifelse(kw_p > 0.05,
         "no significant difference among R-type clades; pooling is supported.",
         "significant difference detected among R-type clades; pooling should be interpreted with caution.")
))

