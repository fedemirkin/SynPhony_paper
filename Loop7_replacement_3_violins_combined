shapiro_y_wt <- tryCatch(shapiro.test(y_wt_vals), error = function(e) NULL)
print(shapiro_r_wt)
print(shapiro_y_wt)

normal_both_wt <- !is.null(shapiro_r_wt) && !is.null(shapiro_y_wt) &&
  shapiro_r_wt$p.value > 0.05 && shapiro_y_wt$p.value > 0.05

if (normal_both_wt) {
