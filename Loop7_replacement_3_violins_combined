cat(sprintf("\nKruskal-Wallis effect size: eta-squared (H-based) = %.3f (%s effect)\n", eta2_H, eta2_interpretation))

cat("\n--- Post-hoc pairwise comparisons among R-type clades (BH-adjusted) ---\n")
