cat(sprintf(
  "\nFor reference: pooled R-type median = %.1f, Y-type median = %.1f (gap = %.1f)\n",
  median(r_vals), median(y_vals), ry_gap
))
cat(sprintf(
  "Range of individual R-type clade medians: %.1f-%.1f (spread = %.1f), i.e. %.0f%% of the R-type vs Y-type gap (%.1f)\n",
  median_range[1], median_range[2], median_spread, 100 * median_spread / ry_gap, ry_gap
))

kw_H <- unname(kw_result$statistic)
kw_k <- length(unique(r_type_df$Assigned_clade))
kw_n <- nrow(r_type_df)
eta2_H <- (kw_H - kw_k + 1) / (kw_n - kw_k)
