# ---- Sanity check: homogeneity among individual R-type clades ----
r_type_df <- df %>% filter(Assigned_clade %in% r_type_clades) %>% droplevels()

cat("\n=== Kruskal-Wallis test across individual R-type clades (1-7) ===\n")
