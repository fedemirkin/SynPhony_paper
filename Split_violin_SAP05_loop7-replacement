###########################################################
# Loop 7 swap tolerance: split violin plot
#
# Left half  = pLDDT of SAP05 with Loop 7 replaced by each
#              donor protein's Loop 7 ("pLDDT_replacement"),
#              points coloured by the donor's Assigned_clade
# Right half = pLDDT of the donor SAP05-like domain in its own,
#              native (unmodified) context ("pLDDT"), shown in grey
#
# No extra packages beyond ggplot2 + dplyr are required (split
# violins are built manually from density() output, since
# gghalves/see are not available through apt in this environment).
############################################################
 
library(ggplot2)
library(dplyr)
library(patchwork)
 
# ------------------------------------------------------------
# 0. Load data
# ------------------------------------------------------------
# Expected columns: Full_name, Assigned_clade, pLDDT,
#                    pLDDT_replacement, Delta
 
# df <- read.csv("loop7_swap_data.csv", stringsAsFactors = FALSE)
 
# ------------------------------------------------------------
# 1. Clade colours
# ------------------------------------------------------------
# Replace these with the exact hex codes used in Fig 1A / S6 Fig
# so colouring is consistent across the manuscript.
clade_colours <- c(
  "Clade_1"  = "#ff8080",
  "Clade_2"  = "#ff9955",
  "Clade_3"  = "#ffcc00",
  "Clade_4"  = "#ff2a7f",
  "Clade_5"  = "#e9afdd",
  "Clade_6"  = "#8080ff",
  "Clade_7"  = "#00aad4",
  "Clade_8"  = "#2ca089",
  "Clade_9"  = "#7f2a7f",
  "Clade_10" = "#aad400"
)
 
# Protein to highlight in black, drawn on top of all other points
# (WP_011412316.1 corresponds to canonical SAP05 itself)
highlight_id <- "WP_011412316.1"
 
# ------------------------------------------------------------
# 2. Density helper: build a mirrored half-violin polygon
# ------------------------------------------------------------
# side = -1 -> violin bulges to the LEFT of x0
# side = +1 -> violin bulges to the RIGHT of x0
half_violin_polygon <- function(values, x0, side, scale_to = 0.4) {
 
  values <- values[is.finite(values)]
  if (length(values) < 2) return(NULL)
 
  d <- density(values, n = 256)
 
  # scale density so the widest point of the violin is `scale_to`
  # units away from the centre line (x0)
  w <- d$y / max(d$y) * scale_to
 
  # build a closed polygon: out along the density profile, back down
  # the centre line, so geom_polygon() fills a proper half-violin shape
  data.frame(
    x = c(x0, x0 + side * w, x0),
    y = c(min(d$x), d$x, max(d$x))
  )
}
 
# ------------------------------------------------------------
# 2b. Statistical comparison: Y-type (Clade_10) vs pooled R-type
#     donor clades, on chimera (pLDDT_replacement) values
# ------------------------------------------------------------
# R-type clades = all clades with the conserved D100/R104 Loop 7
# signature (Clades 1-7); Y-type = Clade_10 only. Clades 8 and 9
# are excluded from this comparison (see main text).
r_type_clades <- paste0("Clade_", 1:7)
y_type_clades <- "Clade_10"
 
df_stat <- df %>%
  filter(Assigned_clade %in% c(r_type_clades, y_type_clades)) %>%
  mutate(loop_type = ifelse(Assigned_clade %in% y_type_clades, "Y-type", "R-type"))
 
r_vals <- df_stat$pLDDT_replacement[df_stat$loop_type == "R-type"]
y_vals <- df_stat$pLDDT_replacement[df_stat$loop_type == "Y-type"]
 
cat("\n--- Shapiro-Wilk normality test ---\n")
shapiro_r <- tryCatch(shapiro.test(r_vals), error = function(e) NULL)
shapiro_y <- tryCatch(shapiro.test(y_vals), error = function(e) NULL)
print(shapiro_r)
print(shapiro_y)
 
normal_both <- !is.null(shapiro_r) && !is.null(shapiro_y) &&
  shapiro_r$p.value > 0.05 && shapiro_y$p.value > 0.05
 
if (normal_both) {
  cat("\n--- Both groups approx. normal: using Welch's t-test ---\n")
  test_result <- t.test(r_vals, y_vals)
  test_method <- "Welch's t-test"
} else {
  cat("\n--- At least one group non-normal: using Wilcoxon rank-sum test ---\n")
  test_result <- wilcox.test(r_vals, y_vals)
  test_method <- "Wilcoxon rank-sum test"
}
print(test_result)
 
p_val <- test_result$p.value
p_label <- if (p_val < 0.0001) "P < 0.0001" else paste0("P = ", signif(p_val, 3))
 
cat(sprintf(
  "\nSummary: %s, chimera pLDDT, R-type (n = %d, median = %.1f) vs Y-type (n = %d, median = %.1f), %s\n",
  test_method, length(r_vals), median(r_vals), length(y_vals), median(y_vals), p_label
))
 
# ------------------------------------------------------------
# 3. Build the two half-violins
# ------------------------------------------------------------
x0 <- 1  # single category on the x-axis
 
violin_chimera <- half_violin_polygon(df$pLDDT_replacement, x0 = x0, side = -1)
violin_wt      <- half_violin_polygon(df$pLDDT,             x0 = x0, side = +1)
 
# ------------------------------------------------------------
# 4. Jittered points for each side
# ------------------------------------------------------------
set.seed(1)
 
points_chimera_all <- df %>%
  mutate(
    x_jit = x0 - 0.08 - runif(n(), 0, 0.18),   # jitter into the left half
    y     = pLDDT_replacement,
    group = "Chimera (SAP05 + donor Loop 7)",
    colour_val = Assigned_clade
  )
 
points_wt_all <- df %>%
  mutate(
    x_jit = x0 + 0.08 + runif(n(), 0, 0.18),   # jitter into the right half
    y     = pLDDT,
    group = "WT SAP05-like domain",
    colour_val = Assigned_clade
  )
 
# split off the highlighted protein (SAP05) so it can be drawn last,
# on top of every other point, in a fixed colour regardless of clade
points_chimera        <- points_chimera_all %>% filter(Full_name != highlight_id)
points_chimera_hl      <- points_chimera_all %>% filter(Full_name == highlight_id)
points_wt              <- points_wt_all %>% filter(Full_name != highlight_id)
points_wt_hl           <- points_wt_all %>% filter(Full_name == highlight_id)
 
# ------------------------------------------------------------
# 5. Panel A: split violin (chimera vs WT pLDDT)
# ------------------------------------------------------------
panel_a <- ggplot() +
 
  # half-violin shapes (plain fill, just showing distribution shape)
  geom_polygon(data = violin_chimera, aes(x = x, y = y),
               fill = "grey85", colour = "grey40", linewidth = 0.3) +
  geom_polygon(data = violin_wt, aes(x = x, y = y),
               fill = "grey85", colour = "grey40", linewidth = 0.3) +
 
  # chimera points, coloured by donor clade
  geom_point(data = points_chimera,
             aes(x = x_jit, y = y, colour = colour_val),
             size = 2, alpha = 0.85) +
 
  # WT points, coloured by the same clade scheme
  geom_point(data = points_wt,
             aes(x = x_jit, y = y, colour = colour_val),
             size = 2, alpha = 0.85) +
 
  # SAP05 itself, drawn last so it sits on top of every other point
  geom_point(data = points_chimera_hl, aes(x = x_jit, y = y),
             colour = "black", size = 3) +
  geom_point(data = points_wt_hl, aes(x = x_jit, y = y),
             colour = "black", size = 3) +
 
  scale_colour_manual(values = clade_colours, name = "Donor clade\n(Loop 7 origin)") +
 
  scale_x_continuous(
    breaks = c(x0 - 0.2, x0 + 0.2),
    labels = c("Chimera\n(SAP05 + donor Loop 7)", "WT\nSAP05-like domain"),
    limits = c(x0 - 0.55, x0 + 0.55)
  ) +
 
  labs(
    x = NULL, y = "pLDDT", title = "A",
    caption = sprintf(
      "Chimera pLDDT, R-type vs Y-type donor Loop 7: %s, %s",
      test_method, p_label
    )
  ) +
  coord_cartesian(ylim = c(0, 100)) +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid.major.x = element_blank(),
    panel.grid.minor   = element_blank(),
    legend.position    = "right",
    plot.title          = element_text(face = "bold"),
    plot.caption        = element_text(hjust = 0, size = 10, colour = "grey30")
  )
 
# ------------------------------------------------------------
# 6. Panel B: Delta (pLDDT - pLDDT_replacement) by Loop type
# ------------------------------------------------------------
# Delta directly measures, per protein, how much confidence is lost
# when that protein's own Loop 7 is grafted into the SAP05 scaffold
# relative to its own native (WT) context. Unlike the raw pLDDT
# comparison in Panel A, this is a swap-specific quantity that
# controls for any baseline differences in how confidently each
# donor's native structure happens to be predicted.
 
# ---- 6a. Statistical comparison: Delta, R-type vs Y-type ----
r_delta <- df_stat$Delta[df_stat$loop_type == "R-type"]
y_delta <- df_stat$Delta[df_stat$loop_type == "Y-type"]
 
cat("\n--- Delta: Shapiro-Wilk normality test ---\n")
shapiro_r_d <- tryCatch(shapiro.test(r_delta), error = function(e) NULL)
shapiro_y_d <- tryCatch(shapiro.test(y_delta), error = function(e) NULL)
print(shapiro_r_d)
print(shapiro_y_d)
 
normal_both_d <- !is.null(shapiro_r_d) && !is.null(shapiro_y_d) &&
  shapiro_r_d$p.value > 0.05 && shapiro_y_d$p.value > 0.05
 
if (normal_both_d) {
  cat("\n--- Delta: both groups approx. normal: using Welch's t-test ---\n")
  test_result_d <- t.test(r_delta, y_delta)
  test_method_d <- "Welch's t-test"
} else {
  cat("\n--- Delta: at least one group non-normal: using Wilcoxon rank-sum test ---\n")
  test_result_d <- wilcox.test(r_delta, y_delta)
  test_method_d <- "Wilcoxon rank-sum test"
}
print(test_result_d)
 
p_val_d <- test_result_d$p.value
p_label_d <- if (p_val_d < 0.0001) "P < 0.0001" else paste0("P = ", signif(p_val_d, 3))
 
cat(sprintf(
  "\nSummary: %s, Delta (pLDDT - pLDDT_replacement), R-type (n = %d, median = %.1f) vs Y-type (n = %d, median = %.1f), %s\n",
  test_method_d, length(r_delta), median(r_delta), length(y_delta), median(y_delta), p_label_d
))
 
# ---- 6a-ii. One-sample tests: is each group's Delta different from 0? ----
# Uses a one-sample Wilcoxon signed-rank test by default, or a one-sample
# t-test if the group's Delta values are approximately normal (same
# normality-based selection logic used elsewhere in this script).
one_sample_test <- function(values, group_label) {
  shapiro_p <- tryCatch(shapiro.test(values)$p.value, error = function(e) NA)
  if (!is.na(shapiro_p) && shapiro_p > 0.05) {
    res <- t.test(values, mu = 0)
    method <- "one-sample t-test"
  } else {
    res <- wilcox.test(values, mu = 0)
    method <- "one-sample Wilcoxon signed-rank test"
  }
  p <- res$p.value
  p_lab <- if (p < 0.0001) "P < 0.0001" else paste0("P = ", signif(p, 3))
  cat(sprintf(
    "\n--- %s vs 0: %s, n = %d, median = %.2f, %s ---\n",
    group_label, method, length(values), median(values), p_lab
  ))
  print(res)
  list(p = p, p_lab = p_lab, method = method)
}
 
cat("\n=== One-sample tests: Delta vs 0, within each group ===\n")
r_vs_zero <- one_sample_test(r_delta, "R-type Delta")
y_vs_zero <- one_sample_test(y_delta, "Y-type Delta")
 
# significance stars for plot annotation
sig_stars <- function(p) {
  if (p < 0.0001) "****"
  else if (p < 0.001) "***"
  else if (p < 0.01) "**"
  else if (p < 0.05) "*"
  else "ns"
}
r_stars <- sig_stars(r_vs_zero$p)
y_stars <- sig_stars(y_vs_zero$p)
 
# ---- 6b. Build Panel B: one violin per loop type, points by clade ----
delta_violin_r <- half_violin_polygon(r_delta, x0 = 1, side = -1, scale_to = 0.4)
delta_violin_y <- half_violin_polygon(y_delta, x0 = 2, side = -1, scale_to = 0.4)
delta_violin_r2 <- half_violin_polygon(r_delta, x0 = 1, side = +1, scale_to = 0.4)
delta_violin_y2 <- half_violin_polygon(y_delta, x0 = 2, side = +1, scale_to = 0.4)
 
set.seed(2)
delta_points_all <- df_stat %>%
  mutate(
    x0    = ifelse(loop_type == "R-type", 1, 2),
    x_jit = x0 + runif(n(), -0.3, 0.3),
    y     = Delta
  )
 
delta_points    <- delta_points_all %>% filter(Full_name != highlight_id)
delta_points_hl <- delta_points_all %>% filter(Full_name == highlight_id)
 
# annotation data: significance stars for each group's Delta vs 0,
# placed just above that group's highest point
sig_annot <- data.frame(
  x = c(1, 2),
  y = c(max(r_delta, na.rm = TRUE), max(y_delta, na.rm = TRUE)) + 2,
  label = c(r_stars, y_stars)
)
 
panel_b <- ggplot() +
  geom_polygon(data = delta_violin_r,  aes(x = x, y = y), fill = "grey85", colour = "grey40", linewidth = 0.3) +
  geom_polygon(data = delta_violin_r2, aes(x = x, y = y), fill = "grey85", colour = "grey40", linewidth = 0.3) +
  geom_polygon(data = delta_violin_y,  aes(x = x, y = y), fill = "grey85", colour = "grey40", linewidth = 0.3) +
  geom_polygon(data = delta_violin_y2, aes(x = x, y = y), fill = "grey85", colour = "grey40", linewidth = 0.3) +
  geom_hline(yintercept = 0, linetype = "dashed", colour = "grey50") +
  geom_point(data = delta_points, aes(x = x_jit, y = y, colour = Assigned_clade),
             size = 2, alpha = 0.85) +
  geom_point(data = delta_points_hl, aes(x = x_jit, y = y),
             colour = "black", size = 3) +
  geom_text(data = sig_annot, aes(x = x, y = y, label = label),
            size = 5, fontface = "bold") +
  scale_colour_manual(values = clade_colours, name = "Donor clade\n(Loop 7 origin)") +
  scale_x_continuous(breaks = c(1, 2), labels = c("R-type", "Y-type"), limits = c(0.5, 2.5)) +
  labs(
    x = NULL, y = expression(Delta * " pLDDT  (WT " - " chimera)"),
    title = "B",
    caption = sprintf(
      "Between groups: %s, %s\nWithin group vs 0: R-type %s (%s), Y-type %s (%s)",
      test_method_d, p_label_d, r_vs_zero$p_lab, r_stars, y_vs_zero$p_lab, y_stars
    )
  ) +
  theme_minimal(base_size = 13) +
  theme(
    panel.grid.major.x = element_blank(),
    panel.grid.minor   = element_blank(),
    legend.position    = "none",
    plot.title         = element_text(face = "bold"),
    plot.caption       = element_text(hjust = 0, size = 10, colour = "grey30")
  )
 
# ------------------------------------------------------------
# 7. Combine panels and save
# ------------------------------------------------------------
combined <- panel_a + panel_b + plot_layout(widths = c(1.3, 1), guides = "collect")
 
print(combined)
