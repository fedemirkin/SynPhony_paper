# ============================================================
# RMSD vs Average_CA_Value (pLDDT), one panel per ID.
#
# Linkers 3, 4, 6, 7 keep their colourblind-safe colours. Any OTHER
# Linkers value that has RMSD > 1 in at least one ID panel is shown
# in GRAY in every panel. Everything else is plain white. SAP05 is
# a solid black reference dot, repeated identically in every panel.
# ============================================================

# --- Packages -------------------------------------------------
# install.packages(c("ggplot2", "dplyr"))  # run once if needed
library(ggplot2)
library(dplyr)

# --- Prep data ----------------------------------------------------
df$ID      <- trimws(as.character(df$ID))       # guard against stray whitespace
df$Linkers <- as.factor(df$Linkers)

# Fixed panel order for the facets. SAP05 is deliberately excluded
# here since it doesn't get its own panel (see below).
id_order  <- c("WP_246454204", "GFP", "SAP54_K61E")
extra_ids <- setdiff(unique(df$ID), c(id_order, "SAP05"))
id_order  <- c(id_order, extra_ids)

df_main <- df %>%
  filter(toupper(ID) != "SAP05") %>%
  mutate(ID = factor(ID, levels = id_order))

# The SAP05 point, kept WITHOUT an ID column, so ggplot has no
# faceting value to match it to a single panel and instead repeats
# ("recycles") this single point identically into every facet.
sap05_point <- df %>%
  filter(toupper(ID) == "SAP05") %>%
  select(RMSD, Average_CA_Value)

# Diagnostic: warn loudly if SAP05 wasn't found, instead of silently
# plotting nothing. Check unique(df$ID) below if this fires.
if (nrow(sap05_point) == 0) {
  warning("No rows matched ID == 'SAP05'. Unique ID values found: ",
          paste(unique(df$ID), collapse = ", "))
}

# --- Colours for Linkers 3, 4, 6, 7 -------------------------------------
# These always keep their assigned colour, even if flagged below.
highlight_levels <- c("3", "4", "6", "7")

# Okabe-Ito colourblind-safe palette
highlight_colors <- c(
  "3" = "#009E73",  # bluish green
  "4" = "#0072B2",  # blue
  "6" = "#D55E00",  # vermillion
  "7" = "#CC79A7"   # reddish purple
)

# --- Flag remaining Linkers with RMSD > 1 in ANY panel ------------------
RMSD_THRESHOLD <- 1
flagged_linkers <- df_main %>%
  filter(RMSD > RMSD_THRESHOLD) %>%
  pull(Linkers) %>%
  unique() %>%
  as.character()
flagged_linkers <- setdiff(flagged_linkers, highlight_levels)  # 3/4/6/7 keep their own colour regardless

cat("Linkers flagged with an X (RMSD >", RMSD_THRESHOLD, "in at least one ID, excluding 3/4/6/7):",
    paste(flagged_linkers, collapse = ", "), "\n")

df_main <- df_main %>%
  mutate(point_group = case_when(
    Linkers %in% highlight_levels ~ as.character(Linkers),
    Linkers %in% flagged_linkers  ~ "flagged",
    TRUE                          ~ "other"
  ))

df_other     <- df_main %>% filter(point_group == "other")
df_flagged   <- df_main %>% filter(point_group == "flagged")
df_highlight <- df_main %>% filter(point_group %in% highlight_levels) %>%
  mutate(point_group = factor(point_group, levels = highlight_levels))

# --- Build plot -----------------------------------------------------
p <- ggplot() +
  geom_point(data = df_other,
             aes(x = RMSD, y = Average_CA_Value),
             shape = 21, fill = "white", color = "black",
             stroke = 0.6, size = 2) +
  geom_point(data = df_flagged,
             aes(x = RMSD, y = Average_CA_Value),
             shape = 4, color = "black",
             stroke = 1, size = 2.5) +
  geom_point(data = df_highlight,
             aes(x = RMSD, y = Average_CA_Value, fill = point_group),
             shape = 21, color = "black", stroke = 0.6, size = 2) +
  geom_point(data = sap05_point,
             aes(x = RMSD, y = Average_CA_Value),
             shape = 21, fill = "black", color = "black",
             stroke = 0.6, size = 2.5) +
  facet_wrap(~ ID, ncol = 3) +
  scale_fill_manual(values = highlight_colors, name = "Linkers", breaks = highlight_levels) +
  coord_cartesian(xlim = c(0, NA), ylim = c(80, 100)) +
  theme_minimal(base_size = 14) +
  theme(panel.spacing = unit(1.2, "lines")) +
  labs(
    x = "RMSD",
    y = "Average CA Value (pLDDT)",
    title = "RMSD vs pLDDT by ID",
    subtitle = paste0("Linkers 3, 4, 6, 7 are colour-filled; black X = other linkers with RMSD > ",
                       RMSD_THRESHOLD, " in at least one ID; black dot = SAP05 reference")
  )

print(p)
